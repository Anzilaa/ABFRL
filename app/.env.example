# Example environment variables for local development
# Copy this to a file named .env and fill with real values (DO NOT commit .env)

# Google API key for Gemini/Generative AI
GOOGLE_API_KEY=your_google_api_key_here

# Set to TRUE to use Vertex AI integration
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Optional: host/port for ADK web UI
ADK_HOST=localhost
ADK_PORT=8000

# Other example variables
# EXAMPLE_VAR=value
